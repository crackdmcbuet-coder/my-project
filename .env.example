# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...
# claude-fable-5-1 | claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
CLAUDE_MODEL=claude-sonnet-5-5
OWNER_NAME=Your Name
# Extra instructions about you / your tone (Bangla/English mix ok)
OWNER_PROFILE=I am a software engineer in Dhaka. Reply politely, short, in the same language the sender used.
HISTORY_LIMIT=40

# Auto-busy schedule (24h, local time). Outside this window you're "free" unless /busy is set.
# Leave empty to only use manual /busy /free.
BUSY_HOURS=09:00-18:00
TIMEZONE=Asia/Dhaka

# --- Telegram (your personal account via Telethon, get from my.telegram.org) ---
TG_API_ID=
TG_API_HASH=
TG_PHONE=+8801XXXXXXXXX

# --- Gmail (OAuth desktop client json from Google Cloud Console) ---
GMAIL_ENABLED=true
GMAIL_CREDENTIALS=credentials.json
GMAIL_POLL_SECONDS=60

# --- WhatsApp Cloud API + Messenger (Meta, webhook) ---
META_VERIFY_TOKEN=choose-any-secret
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_TOKEN=
WEBHOOK_PORT=8000

DB_PATH=data/assistant.db
