ANTHROPIC_API_KEY=            # from console.anthropic.com
# ANTHROPIC_MODEL=claude-opus-5-5   # cheaper option: claude-sonnet-5-5
# DREAMS_PATH=data/dreams.json
# SHORTLIST_SIZE=10
# MIN_SCORE=0.1
# MAX_INPUT_CHARS=1000
# RATE_LIMIT_CALLS=20
# RATE_LIMIT_WINDOW_S=600
# TRUST_FORWARDED_FOR=true          # set when behind nginx / a proxy
# ALLOWED_ORIGINS=https://your-site.com
